  FM -- monitors --> VENT
  FM -- monitors --> SEC
  FIRE -- "sensors / actuators" --> BS
  VENT -- "sensors / actuators" --> BS
  SEC -- "sensors / actuators" --> BS
  classDef person fill:#084298,stroke:#052c65,color:#ffffff
  classDef sys fill:#1c68c4,stroke:#0b3d7a,color:#ffffff
