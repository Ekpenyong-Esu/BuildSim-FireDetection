%% C4 Component diagram (Level 3): inside the firelab service.
%% Edges between the groups go group to group, so each group keeps its own row.
flowchart TB
  subgraph TRUTH["Sees the truth"]
    direction LR
    SRC["<b>Sources</b><br/>fires, cooking,<br/>dust, steam"]
    PHY["<b>Physics</b><br/>heat, smoke, CO<br/>per room"]
    SEN["<b>Sensing</b><br/>lag, noise, faults"]
    SCO["<b>Scoreboard</b><br/>catches, misses,<br/>false alarms, RSET"]
    SRC --> PHY --> SEN
    SRC -. labels .-> SCO
  end
  subgraph READ["Sees sensor readings only"]
    direction LR
    FEA["<b>Features</b><br/>last 120 s per room"]
    DET["<b>Detector</b><br/>fusion rule or LLM"]
    AGT["<b>Room agent</b><br/>alarm state machine"]
    LLMA["<b>LLM adapter</b><br/>asks in the background,<br/>keeps answers 60 s"]
    FEA --> DET -- "P(fire)" --> AGT
    DET <--> LLMA
  end
  subgraph ACT["Acts and shows"]
    direction LR
    ILK["<b>Safety rules</b><br/>water needs heat,<br/>never seal people in"]
    ACTU["<b>Actuation</b><br/>sprinkler, doors,<br/>evacuate"]
    EVA["<b>Evacuation</b><br/>shortest safe route"]
    PUB["<b>Publisher + API</b><br/>BuildSim, panel, CSV"]
    ILK -- allowed --> ACTU --> EVA --> PUB
  end
  EP["<b>Language model</b><br/>external, HTTPS"]
  TRUTH -- readings --> READ
  READ -- "proposed commands" --> ACT
  TRUTH === |"sprinkler and doors<br/>feed back into the world"| ACT
  READ -. "one room at a time" .-> EP
  classDef truth fill:#fde3d3,stroke:#e25822,color:#5a1e05
  classDef read fill:#d9f2e3,stroke:#16a34a,color:#0f3d22
  classDef act fill:#dbe8fb,stroke:#1c68c4,color:#0b2e5c
  classDef model fill:#7c3aed,stroke:#5b21b6,color:#ffffff
  class SRC,PHY,SEN,SCO truth
  class FEA,DET,LLMA,AGT read
  class ILK,ACTU,EVA,PUB act
  class EP model
  style TRUTH fill:#fff7f2,stroke:#e25822,stroke-dasharray:6 4
  style READ fill:#f3fbf6,stroke:#16a34a,stroke-dasharray:6 4
  style ACT fill:#f3f7fd,stroke:#1c68c4,stroke-dasharray:6 4
