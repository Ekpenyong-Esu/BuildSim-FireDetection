%%{init: {"flowchart": {"wrappingWidth": 320}}}%%
%% Deployment view: two processes and two browser tabs on one laptop, one call out
flowchart LR
  subgraph LAPTOP["Laptop (127.0.0.1 only)"]
    direction LR
    subgraph FIRE["firelab (this project)"]
      direction TB
      PANEL["<b>Control panel</b><br/>Svelte app in a browser tab"]
      SVC["<b>firelab service</b><br/>Python 3.10, uvicorn, port 8090<br/>one process, a tick every 250 ms"]
      PANEL -- "REST + SSE" --> SVC
    end
    subgraph BSIDE["BuildSim"]
      direction TB
      BS["<b>BuildSim</b><br/>Go binary, port 9090"]
      VIEWER["<b>3D viewer</b><br/>browser tab"]
      BS -- WebSocket --> VIEWER
    end
    FIRE -- REST --> BSIDE
  end
  LLM["<b>Language model</b><br/>canopus.eislab.se, HTTPS<br/>qwen3.8-27b"]
  FIRE -.-> LLM
  classDef cont fill:#1c68c4,stroke:#0b3d7a,color:#ffffff
  classDef ext fill:#6b7280,stroke:#4b5563,color:#ffffff
  classDef model fill:#7c3aed,stroke:#5b21b6,color:#ffffff
  class SVC,PANEL cont
  class BS,VIEWER ext
  class LLM model
  style LAPTOP fill:#ffffff,stroke:#374151,stroke-dasharray:6 4
  style FIRE fill:#eef4fc,stroke:#1c68c4
  style BSIDE fill:#f3f4f6,stroke:#6b7280
