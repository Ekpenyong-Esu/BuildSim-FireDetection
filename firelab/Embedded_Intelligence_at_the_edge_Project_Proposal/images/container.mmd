%% C4 Container diagram (Level 2). The edges from the system boundary are the
%% firelab service's own traffic: REST to BuildSim, HTTPS to the model.
flowchart LR
  subgraph SYS["Fire detection &amp; response [Software System]"]
    direction TB
    UI["<b>Control panel</b><br/>[Container: Svelte 5, browser tab]<br/>scenario, sensors, rooms, response,<br/>detector choice, scorecard, journal"]
    SVC["<b>firelab service</b><br/>[Container: Python 3, FastAPI + asyncio]<br/>the tick loop: world, sensing, intelligence<br/>(rule or model), actuation, evacuation, publishing"]
    UI -- "commands [REST]<br/>one snapshot per tick [SSE]" --> SVC
  end
  BS["<b>BuildSim</b><br/>[Container: Go, :9090]<br/>building state, equipment tree,<br/>session API"]
  VIEWER["<b>BuildSim 3D viewer</b><br/>[Container: browser tab]<br/>heat maps, effects, people,<br/>outlines, route"]
  LLM["<b>Language model endpoint</b><br/>[Container: OpenAI-compatible chat API, HTTPS]<br/>the one thing off the laptop; optional,<br/>the rule scores every room without it"]
  SYS -- "firelab service: GET floors, stairs, routes;<br/>PUT layers, effects, alerts, doors, people,<br/>sensor values, session outlines and route<br/>[REST, once a simulated second]" --> BS
  SYS -- "firelab service: one room's readings in,<br/>a JSON verdict out [HTTPS, in the background,<br/>never on the tick; about 8 s an answer]" --> LLM
  BS -- "live state [WebSocket]" --> VIEWER
  classDef cont fill:#438cde,stroke:#0b3d7a,color:#ffffff
  classDef ext fill:#999999,stroke:#666666,color:#ffffff
  class UI,SVC cont
  class VIEWER,BS,LLM ext
  style SYS fill:#ffffff,stroke:#1c68c4,stroke-dasharray:6 4
